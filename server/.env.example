# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to Git — add ".env" to .gitignore.

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# --- PostgreSQL ---
# For local dev you can use individual fields, OR set DATABASE_URL for hosted DBs
# (Railway/Render/Neon all give you a single connection string like this).
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce
PG_SSL=false
# Set PG_SSL=true when connecting to a hosted Postgres (Railway/Render/Neon/Supabase)

# --- Auth0 ---
# From your Auth0 Dashboard > Applications > APIs (the API you create for this backend)
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.us.auth0.com/

# --- Stripe ---
# From your Stripe Dashboard > Developers > API keys (use TEST keys until launch)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# From Stripe Dashboard > Developers > Webhooks, after adding your webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Sentry (error monitoring) — optional, leave blank to disable ---
# From sentry.io > your project > Settings > Client Keys (DSN)
SENTRY_DSN=

# --- Redis (product listing cache) — optional, leave blank to disable ---
# Railway: add the Redis plugin to your project, it gives you this automatically
REDIS_URL=

# --- Auth0 Management API (needed only for the GDPR "delete my account" route) ---
# Auth0 Dashboard > Applications > create a "Machine to Machine" app,
# authorize it for the Auth0 Management API with the "delete:users" scope
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- Low-stock alert job ---
LOW_STOCK_THRESHOLD=5
