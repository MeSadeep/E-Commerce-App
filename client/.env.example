# Copy to ".env" for local dev (Create React App requires the REACT_APP_ prefix).
# These are PUBLIC values baked into the frontend bundle — never put secret keys here.

# Silences harmless "Failed to parse source map" warnings from third-party
# packages (lucide-react, etc.) that ship without .map debug files — this is
# a cosmetic dev-terminal-only issue, not a real problem, but it's noisy.
# Trade-off: your own app's source maps are also skipped in dev, so a JS
# error's stack trace may point to bundled code instead of your exact
# original source line. Rarely matters day-to-day.
GENERATE_SOURCEMAP=false

REACT_APP_API_URL=http://localhost:4000

REACT_APP_AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your_auth0_spa_client_id
REACT_APP_AUTH0_AUDIENCE=https://your-api-identifier

# --- Optional: error monitoring (leave blank to disable) ---
REACT_APP_SENTRY_DSN=

# --- Optional: Google Analytics (leave blank to disable) ---
REACT_APP_GA_ID=
